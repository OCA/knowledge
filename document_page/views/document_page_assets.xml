<odoo>
    <template
        id="assets_backend"
        name="document_page assets"
        inherit_id="web.assets_backend"
    >
        <xpath expr="." position="inside">
            <link
                rel="stylesheet"
                type="text/scss"
                href="/document_page/static/src/scss/document_page.scss"
            />
            <script
                type="text/javascript"
                src="/document_page/static/src/js/document_page_kanban.js"
            />
        </xpath>
    </template>
    <template
        id="assets_tests"
        name="document_page tests assets"
        inherit_id="web.assets_tests"
    >
        <xpath expr="." position="inside">
            <script
                type="text/javascript"
                src="/document_page/static/tests/tours/document_page_browse_content.js"
            />
        </xpath>
    </template>
</odoo>
