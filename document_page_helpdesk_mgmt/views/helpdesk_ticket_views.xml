<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_ticket_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('align-items-center')]" position="inside">
                <a
                    class="o_kanban_inline_block"
                    name="%(action_document_page_helpdesk_tickets)d"
                    type="action"
                >
                    <div>
                        <b>
                            <field
                                name="document_page_count"
                                nolabel="1"
                                class="o_value"
                            />
                        </b>
                        <span class="o_label">Wiki Pages</span>
                    </div>
                </a>
            </xpath>
        </field>
    </record>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form - document_page_helpdesk_mgmt</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(action_document_page_helpdesk_tickets)d"
                    icon="fa-book"
                >
                    <field
                        string="Wiki Pages"
                        name="document_page_count"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
