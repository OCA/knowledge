<odoo noupdate="1">
    <!-- Permissions are OR-ed together, so the unrestricted permissions of
         document_page have to be disabled for the ones of this module (which
         carry the groups/users domain) to restrict anything. Managers keep
         full access through document_page.document_page_manager. These
         records are enabled again by the uninstall hook. -->
    <record id="document_page.document_page_user" model="ir.access">
        <field name="active" eval="False" />
    </record>
    <record id="document_page.document_page_editor" model="ir.access">
        <field name="active" eval="False" />
    </record>
</odoo>
