<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_project_kanban" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_card" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_project_kanban_body')]" position="inside">
                <div
                    class="d-flex gap-2 align-items-baseline text-muted text-truncate"
                    name="%(action_document_page_projects)d"
                    type="action"
                >
                    <i
                        class="oi oi-filled"
                        data-icon="book"
                        title="Wiki Pages"
                        data-tooltip="Wiki Pages"
                    />
                    <span>
                        <field name="document_page_count" class="o_value" /> Wiki Pages
                    </span>
                </div>
            </xpath>
        </field>
    </record>
    <record id="edit_project" model="ir.ui.view">
        <field name="name">project.project.form - document_page_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(action_document_page_projects)d"
                    icon="book"
                >
                    <field
                        string="Wiki Pages"
                        name="document_page_count"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
